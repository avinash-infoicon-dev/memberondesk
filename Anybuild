# Wasmer Build Config runs install before COPY. Stage lockfiles into /app
# so `npm install` / `composer install` can see them.
# Uploads live in public/uploads (served directly by php -S).
#
# Use php_serve (not laravel_serve): laravel_serve hardcodes
# commands=laravel_commands(config) and then **overrides, so passing
# commands= causes "Argument 'commands' occurs more than once" and
# locks the Wasmer Build Config UI.

load("//anybuild/tools:laravel.bzl", "laravel_build", "laravel_config")
load("//anybuild/tools:php.bzl", "php_serve")

config = laravel_config(
    schema = 1,
    node_package_manager = "npm",
    node_version = "24",
    npm_version = "11",
    node_build_command = "npm run build",
    php_framework = "laravel",
    composer_enable = True,
    composer_build_script = "post-update-cmd",
    php_version = "8.3.29",
    php_public_dir = "public",
)

build = laravel_build(config)

php_serve(
    config,
    build,
    name = "memberondesk",
    provider = "laravel",
    commands = {
        "start": "php -S 0.0.0.0:{} -t public public/wasmer-router.php".format(config.port),
        # No shell `mkdir` — Wasmer cannot run that binary. Dirs are created
        # in build_post; runtime ensure + migrate via PHP only.
        "after_deploy": "php -r '$d=[\"public/uploads\",\"storage/app/public\",\"storage/framework/sessions\",\"storage/framework/views\",\"storage/framework/cache/data\",\"storage/logs\",\"bootstrap/cache\"];foreach($d as $p){@mkdir($p,0777,true);}' && php artisan migrate --force",
    },
    prepare = [
        workdir(build.app.serve_path),
        run("php artisan config:cache"),
        run("php artisan event:cache"),
        run("php artisan route:cache"),
        run("php artisan view:cache"),
    ],
    build_pre = [
        workdir("/app"),
        copy("composer.json"),
        copy("composer.lock") if file_exists("composer.lock") else None,
        copy("package.json") if file_exists("package.json") else None,
    ],
    build_post = [
        run(
            "mkdir -p public/uploads storage/app/public storage/framework/sessions storage/framework/views storage/framework/cache/data storage/framework/testing storage/logs bootstrap/cache",
            group = "build",
        ),
    ],
)
