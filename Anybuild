# Wasmer injects `composer install` as the first install step, before COPY.
# Stage Composer files into /app first so that command can see them.

load("//anybuild/tools:laravel.bzl", "laravel_build", "laravel_config", "laravel_serve")

config = laravel_config(
    schema = 1,
    node_package_manager = "npm",
    node_version = "24",
    npm_version = "11",
    php_framework = "laravel",
    composer_enable = True,
    composer_build_script = "post-update-cmd",
    php_version = "8.3.29",
    php_public_dir = "public",
)

build = laravel_build(config)

laravel_serve(
    config,
    build,
    name = "memberondesk",
    build_pre = [
        workdir("/app"),
        copy("composer.json"),
        copy("composer.lock") if file_exists("composer.lock") else None,
    ],
)
