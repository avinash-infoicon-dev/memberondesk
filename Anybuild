# Wasmer Cloud (Anybuild 0.33.x) runs `composer install` before COPY, and
# unlike npm it does not bind-mount composer.json. Disable that install step
# and run Composer after the app sources are copied.

load("//anybuild/tools:laravel.bzl", "laravel_config", "laravel_serve")
load("//anybuild/tools:node.bzl", "node_build_step", "node_install_steps", "node_toolchain")
load("//anybuild/tools:php.bzl", "php_build")

config = laravel_config(
    schema = 1,
    node_package_manager = "npm",
    node_version = "24",
    npm_version = "11",
    php_framework = "laravel",
    composer_enable = False,
    php_version = "8.3.29",
    php_public_dir = "public",
)

node_tc = node_toolchain(config, serving = False)

build = php_build(
    config,
    extra_use_deps = node_tc.build_deps,
    after_install = node_install_steps(config),
    after_build = [
        env(COMPOSER_HOME = "/tmp", COMPOSER_FUND = "0", COMPOSER_ALLOW_SUPERUSER = "1"),
        run(
            "composer install --optimize-autoloader --ignore-platform-reqs --no-scripts --no-interaction",
            group = "build",
        ),
        run("composer run-script post-update-cmd", group = "build"),
    ] + node_build_step(config, serving = False, static = True),
    extra_ignore = ["node_modules", "vendor"],
)

laravel_serve(
    config,
    build,
    name = "memberondesk",
    build_pre = [
        use(dep("composer")),
    ],
)
